{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "kirana-servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Backend (API)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "kirana-servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Full App (Frontend + Backend)",
      "dependsOn": [
        "Run Frontend (Vite)",
        "Run Backend (API)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
